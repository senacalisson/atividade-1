<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Cadastro Startup</title>
    <style>
        body { font-family: sans-serif; display: flex; justify-content: center; padding: 20px; background: #f4f4f9; }
        .card { background: white; padding: 2rem; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); width: 100%; max-width: 400px; }
        .field { margin-bottom: 15px; }
        label { display: block; margin-bottom: 5px; font-weight: bold; }
        input { width: 100%; padding: 8px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 4px; }
        .error { color: #e74c3c; font-size: 0.85rem; margin-top: 5px; display: none; }
        button { width: 100%; padding: 10px; background: #2ecc71; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 1rem; }
        button:hover { background: #27ae60; }
        #successMsg { color: #27ae60; text-align: center; font-weight: bold; margin-top: 15px; display: none; }
    </style>
</head>
<body>

<div class="card">
    <form id="formCadastro">
        <div class="field">
            <label>Nome</label>
            <input type="text" id="nome">
            <div class="error" id="err-nome">O nome é obrigatório.</div>
        </div>
        <div class="field">
            <label>Email</label>
            <input type="email" id="email">
            <div class="error" id="err-email">Insira um email válido.</div>
        </div>
        <div class="field">
            <label>Idade</label>
            <input type="number" id="idade">
            <div class="error" id="err-idade">Você deve ter pelo menos 18 anos.</div>
        </div>
        <div class="field">
            <label>Senha</label>
            <input type="password" id="senha">
            <div class="error" id="err-senha">Mínimo de 8 caracteres.</div>
        </div>
        <div class="field">
            <label>Confirmar Senha</label>
            <input type="password" id="confirmar">
            <div class="error" id="err-confirmar">As senhas não coincidem.</div>
        </div>
        <button type="submit">Cadastrar</button>
    </form>
    <div id="successMsg">Cadastro realizado com sucesso!</div>
</div>

<script>
const form = document.getElementById('formCadastro');
const successMsg = document.getElementById('successMsg');

form.addEventListener('submit', (e) => {
    e.preventDefault();
    
    let isValid = true;
    const inputs = {
        nome: document.getElementById('nome'),
        email: document.getElementById('email'),
        idade: document.getElementById('idade'),
        senha: document.getElementById('senha'),
        confirmar: document.getElementById('confirmar')
    };

    document.querySelectorAll('.error').forEach(el => el.style.display = 'none');
    successMsg.style.display = 'none';

    if (inputs.nome.value.trim() === '') {
        document.getElementById('err-nome').style.display = 'block';
        isValid = false;
    }
    if (!inputs.email.value.includes('@')) {
        document.getElementById('err-email').style.display = 'block';
        isValid = false;
    }
    if (Number(inputs.idade.value) < 18) {
        document.getElementById('err-idade').style.display = 'block';
        isValid = false;
    }
    if (inputs.senha.value.length < 8) {
        document.getElementById('err-senha').style.display = 'block';
        isValid = false;
    }
    if (inputs.senha.value !== inputs.confirmar.value || inputs.confirmar.value === '') {
        document.getElementById('err-confirmar').style.display = 'block';
        isValid = false;
    }

    if (isValid) {
        successMsg.style.display = 'block';
        form.reset();
    }
});
</script>

</body>
</html>