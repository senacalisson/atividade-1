<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Jogo de Adivinhação</title>
</head>
<body>

    <h2>Adivinhe o Número (1 a 20)</h2>
    
    <input type="number" id="palpite" min="1" max="20">
    <button id="btnTentar">Tentar</button>
    <button id="btnReiniciar">Reiniciar</button>

    <p id="mensagem"></p>
    <p>Tentativas: <span id="tentativas">0</span></p>

    <script>
        let numeroSecreto;
        let contador;

        function iniciarJogo() {
            numeroSecreto = Math.floor(Math.random() * 20) + 1;
            contador = 0;
            document.getElementById('mensagem').textContent = "";
            document.getElementById('tentativas').textContent = "0";
            document.getElementById('palpite').value = "";
        }

        const campoPalpite = document.getElementById('palpite');
        const botaoTentar = document.getElementById('btnTentar');
        const botaoReiniciar = document.getElementById('btnReiniciar');
        const textoMensagem = document.getElementById('mensagem');
        const textoTentativas = document.getElementById('tentativas');

        botaoTentar.addEventListener('click', function() {
            const palpiteUsuario = Number(campoPalpite.value);
            contador++;
            textoTentativas.textContent = contador;

            if (palpiteUsuario === numeroSecreto) {
                textoMensagem.textContent = "Acertou!";
                textoMensagem.style.color = "green";
            } else if (palpiteUsuario > numeroSecreto) {
                textoMensagem.textContent = "Muito alto";
                textoMensagem.style.color = "red";
            } else {
                textoMensagem.textContent = "Muito baixo";
                textoMensagem.style.color = "blue";
            }
        });

        botaoReiniciar.addEventListener('click', iniciarJogo);

        iniciarJogo();
    </script>
</body>
</html>
