<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Sistema de Cadastro</title>
    <style>
        .erro { color: red; font-size: 12px; display: none; }
        input { display: block; margin-top: 10px; }
    </style>
</head>
<body>

    <h2>Cadastro de Usuário</h2>

    <form id="meuFormulario">
        <input type="text" id="nome" placeholder="Digite seu nome">
        <span id="erroNome" class="erro">O nome não pode estar vazio!</span>

        <input type="text" id="email" placeholder="Digite seu e-mail">
        <span id="erroEmail" class="erro">E-mail inválido (deve conter "@")!</span>

        <button type="submit" style="margin-top: 15px;">Cadastrar</button>
    </form>

    <script>
        const form = document.getElementById('meuFormulario');
        const nomeInput = document.getElementById('nome');
        const emailInput = document.getElementById('email');
        const erroNome = document.getElementById('erroNome');
        const erroEmail = document.getElementById('erroEmail');

        form.addEventListener('submit', function(event) {
            event.preventDefault(); 
            
            let valido = true;

            if (nomeInput.value.trim() === "") {
                erroNome.style.display = "block";
                valido = false;
            } else {
                erroNome.style.display = "none";
            }

            if (!emailInput.value.includes("@")) {
                erroEmail.style.display = "block";
                valido = false;
            } else {
                erroEmail.style.display = "none";
            }

            if (valido) {
                alert("Cadastro realizado com sucesso!");
                form.reset();
            }
        });
    </script>

</body>
</html>
